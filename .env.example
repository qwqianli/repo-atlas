# 复制成 .env 后填入你自己的值。.env 已被 gitignore，不会进版本库。
# 用法：cp .env.example .env

# 智谱开放平台的标准 API Key（https://bigmodel.cn/usercenter/proj-mgmt/apikeys）
ZHIPU_API_KEY=

# 模型编码（全小写带连字符）。GLM-4.7-Flash 免费，200K 上下文
GLM_MODEL=glm-4.7-flash

# 仅当要用自建代理/中转时才改
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 单次请求超时（秒）
LLM_TIMEOUT=60

# 并发数。免费档并发上限是 1，调大只会整批 429
LLM_MAX_WORKERS=1

# 两次真实请求之间的最小间隔（秒）
LLM_MIN_INTERVAL=0.5

# 送给模型的单个文件字符上限，超出则按「docstring + import + 函数签名」截断
MAX_FILE_CHARS=6000

# 提示词版本号：改了提示词就同时改这个，否则旧缓存会继续命中
PROMPT_VERSION=v1

# SQLite 缓存文件位置（默认 backend/data/atlas.db）
# DB_PATH=
